# Dotfiles Repository - .gitignore
# Portable configuration only. Machine-specific and transient files are excluded.

# ============================================
# System Files
# ============================================

.DS_Store
*~
*.swp
*.swo

# ============================================
# Credentials and application state
# ============================================

.config/gh/hosts.yml
.config/gcloud/
.config/github-copilot/
.config/planetscale/
.config/raycast/

# Full Raycast .rayconfig backups can contain tokens / clipboard history —
# keep them out of git. Prefer raycast/quicklinks.json (and snippets.json).
*.rayconfig

# Claude / Codex / Cursor app state (credentials, sessions, caches).
# Skills live in skills/ and are symlinked into these dirs at setup time.
.claude/
.codex/
.cursor/

# ============================================
# Fish - Lockfile-only tracking
# ============================================
# Track only the source of truth; the rest is installed by fisher.
# On a new machine, run `fisher update` to reinstall everything in fish_plugins.
#
# fish_variables (universal-variable state) is intentionally NOT tracked.
.config/fish/*
!.config/fish/config.fish
!.config/fish/fish_plugins

# ============================================
# Zellij
# ============================================

.config/zellij/*.bak
.config/zellij/*.bak.*

# ============================================
# Neovim - Plugin and Runtime Data
# ============================================

.config/nvim/.tests/
.config/nvim/.repro/
.config/nvim/doc/tags
.config/nvim/data/
.config/nvim/*.log

# ============================================
# mise
# ============================================
# Local/trusted config and caches stay on the machine.
.config/mise/config.local.toml
